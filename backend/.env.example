# Flask Configuration
FLASK_APP=run.py
FLASK_ENV=development
DEBUG=True
PORT=5000

# Security Keys (Replace with strong random strings in production)
SECRET_KEY=smart_pet_secret_key_change_in_production_anurag_2026
JWT_SECRET_KEY=smart_pet_jwt_secret_key_change_in_production_anurag_2026
JWT_EXPIRATION_HOURS=24

# MySQL 8 Database Configuration
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smart_pet_tracking

# Optional explicit Database URL (overrides DB_* variables above if provided)
# Example for MySQL:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/smart_pet_tracking
# Example for SQLite zero-setup testing:
# USE_SQLITE=true

# Geofence & Tracking Configuration
DEFAULT_SAFEZONE_RADIUS=100.0
SIMULATION_MODE=true
